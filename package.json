{
  "name": "mixora-catalog",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "worker:build": "node tools/build-worker.mjs",
    "worker:dry-run": "wrangler deploy --dry-run",
    "worker:types": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "node tools/generate-demo-audio.mjs && tsx --test tests/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "cloud:verify": "tsx scripts/verify-cloud.ts",
    "agreement:verify-storage": "tsx scripts/verify-agreement-storage.ts",
    "staff:verify": "tsx scripts/verify-staff.ts",
    "staff:role": "tsx scripts/staff-roles.ts",
    "staff:role-audit": "tsx scripts/verify-staff-role-audit.ts",
    "catalog:import": "tsx scripts/import-inbox.ts",
    "catalog:import-manifest": "tsx scripts/import-catalog.ts",
    "catalog:sync-provider": "tsx scripts/sync-provider.ts",
    "catalog:worker": "tsx scripts/worker-loop.ts",
    "catalog:unpublish": "tsx scripts/unpublish.ts",
    "demo:generate": "node tools/generate-demo-audio.mjs",
    "catalog:import-demo": "tsx scripts/import-catalog.ts data/demo/manifest.json",
    "catalog:publish": "tsx scripts/publish.ts",
    "catalog:review": "tsx scripts/review.ts approve",
    "partner:register": "tsx scripts/partners.ts register",
    "partner:verify": "tsx scripts/partners.ts verify",
    "partner:reject": "tsx scripts/partners.ts reject",
    "partner:revoke": "tsx scripts/partners.ts revoke",
    "catalog:reject": "tsx scripts/review.ts reject",
    "audit:verify": "tsx scripts/verify-audit.ts",
    "catalog:verify-demo": "tsx scripts/verify-demo.ts",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "@opennextjs/cloudflare": "1.20.3",
    "@vinext/cloudflare": "^1.4.0",
    "jose": "^6.2.17",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "1.0.0-rc.1",
    "tsx": "4.23.15",
    "typescript": "^5.9.0",
    "vite": "8.3.0",
    "wrangler": "4.165.0"
  },
  "type": "module"
}
